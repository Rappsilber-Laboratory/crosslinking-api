[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = "*"
lxml = ">=4.9.1"
numpy = ">=1.14.3"
pandas = ">=0.21.0"
pymzml = ">=0.7.8"
pyteomics = ">=3.4.2"
requests = ">=2.20.1"
urllib3 = ">=2.8.0"
psycopg2-binary = "*"
sqlalchemy = "*"
sqlalchemy-utils = "*"
obonet = "*"
orjson = "*"
python-multipart = ">=0.0.31"
mzidentml-reader = ">=0.4.22"
redis = "*"
hiredis = "*"
asyncpg = "*"
xi2annotator = "*"
# security floors for transitive dependencies (remove once parents require them)
anyio = ">=4.14.2"  # GHSA-5p39-cfhj-2xmp, via starlette/httpx
certifi = ">=2026.10.18"  # GHSA-6q48-6c7w-9gw2, via requests/httpx
idna = ">=3.15"  # GHSA-65pc-fj4g-8rjx, via requests/anyio
starlette = ">=1.3.1"  # GHSA-82w8-qh3p-5jfq et al., via fastapi
werkzeug = ">=3.1.9"  # GHSA-g6x2-hccm-hh4m, via flask (xi2annotator)
# TEMPORARY: unused packages still required by mzidentml-reader 0.4.24 (dropped on its dev branch).
# Remove these floors once a newer mzidentml-reader release is locked.
virtualenv = ">=21.14.9"  # GHSA-394h-qwmc-48pf et al.
filelock = ">=4.2.1"  # GHSA-567q-5qvw-pf92 et al., via virtualenv

[dev-packages]
pytest = "*"
pytest-cov = "*"
pytest-asyncio = "*"
httpx = "*"
responses = "*"

[requires]
python_version = "3.11"
